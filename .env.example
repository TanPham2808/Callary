# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env.
# Trên Render/PaaS thì không cần file .env — đặt thẳng các biến này trong dashboard.

# ── Bắt buộc ────────────────────────────────────────────────────────────────
# Chuỗi random để ký cookie đăng nhập. Thiếu là server không khởi động được.
# Sinh mới:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Tài khoản đăng nhập ─────────────────────────────────────────────────────
# Chỉ dùng để tạo tài khoản LẦN ĐẦU, khi database chưa có tài khoản nào.
# Sau đó mật khẩu nằm trong database (bảng settings), sửa 2 biến này không đổi
# được mật khẩu đang dùng.
AUTH_USERNAME=
AUTH_PASSWORD=

# ── Nơi lưu dữ liệu ─────────────────────────────────────────────────────────
# local   (mặc định) — file SQLite trên đĩa
# replica            — file local để đọc nhanh, ghi đẩy lên Turso; dùng cho host
#                      KHÔNG có đĩa bền (Render free): file mất khi deploy lại,
#                      boot sau tự tải lại từ Turso
# remote             — không cần đĩa, mọi truy vấn đi thẳng lên Turso (chậm hơn)
# Chi tiết: server/src/db.ts
CALLARY_DB_MODE=local

# Đường dẫn file SQLite, dùng cho chế độ local và replica.
# Mặc định: data/callary.db. Trên host không có đĩa bền, đặt /tmp/callary.db
# CALLARY_DB=

# Bắt buộc khi CALLARY_DB_MODE là replica hoặc remote.
# TURSO_DATABASE_URL=libsql://<ten-db>-<to-chuc>.turso.io
# TURSO_AUTH_TOKEN=
#
# Region: Turso không có điểm đặt tại VN hay Singapore. Đo từ VN (09/2026):
# Mumbai aws-ap-south-1 ~109ms, Tokyo aws-ap-northeast-1 ~118ms,
# Oregon aws-us-west-2 ~241ms. Đang dùng Mumbai. Server chạy ở VN thì đặt
# CALLARY_DB_MODE=replica — đọc từ file local nên độ trễ region gần như không
# ảnh hưởng; để `remote` thì xuất Excel mất ~16 giây thay vì ~11ms.
